AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional; Google button hides itself when unset:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# E2E (Playwright, `npm run e2e`) needs its own real Postgres — see playwright.config.ts.
# E2E_DATABASE_URL=postgres://postgres:pg@localhost:5433/puzzlegeeks
